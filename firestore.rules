rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public reads for catalog collections only. Sensitive collections
    // remain server-only and are accessed by future admin features through
    // authenticated server routes, never directly from the browser.
    match /{collectionName}/{document} {
      allow read: if collectionName != 'orders'
        && collectionName != 'mail'
        && collectionName != 'pendingOrders'
        && collectionName != 'newsletter';
      allow write: if false;
    }

    // Allow read access to the _config collection for dynamic collection discovery
    match /_config/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Secure orders collection.
    // Clients can never read or write directly.
    // Read and write operations must go through the secure backend server via Admin SDK.
    match /orders/{document} {
      allow read, write: if false;
    }

    // Secure mail trigger collection.
    // Clients can never read or write directly, protecting the system from spam/abuse.
    // Mail creation is handled strictly by the server.
    match /mail/{document} {
      allow read, write: if false;
    }

    // Checkout and newsletter records contain customer data. Client access is
    // denied even for authenticated users; trusted server code uses Admin SDK.
    match /pendingOrders/{document} {
      allow read, write: if false;
    }

    match /newsletter/{document} {
      allow read, write: if false;
    }

  }
}
